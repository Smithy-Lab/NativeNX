// SPDX-License-Identifier: GPL-3.0-or-later
// nxlinux's Windows resources: NativeNX's icon, the manifest and the version
#include <winver.h>
1 ICON "nativenx.ico"
1 24 "nxlinux.manifest"
1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "nxlinux, Switch games run natively"
      VALUE "ProductName", "nxlinux"
      VALUE "FileVersion", "0.1.0"
      VALUE "ProductVersion", "0.1.0"
      VALUE "LegalCopyright", "GPL-3.0-or-later"
      VALUE "OriginalFilename", "nxlinux.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
