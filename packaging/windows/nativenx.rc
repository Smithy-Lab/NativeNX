// SPDX-License-Identifier: GPL-3.0-or-later
// NativeNX's Windows resources: its icon (made from launcher/data/nativenx-icon.png), manifest and version
#include <winver.h>
1 ICON "nativenx.ico"
1 24 "nxlinux.manifest"
1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "NativeNX, a launcher for Switch games run natively"
      VALUE "ProductName", "NativeNX"
      VALUE "FileVersion", "0.1.0"
      VALUE "ProductVersion", "0.1.0"
      VALUE "LegalCopyright", "GPL-3.0-or-later"
      VALUE "OriginalFilename", "nativenx.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
