#version 450
// SPDX-License-Identifier: GPL-3.0-or-later
// AMD FidelityFX Super Resolution 1.0, the upscaling pass (EASU), for the window (gfx/vk_present.c): the game's frame
// (crop rectangle, possibly stored upside down) upscaled to the size it is shown at. FSR itself: third_party/fsr (MIT)
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D src;
layout(binding = 1, rgba8) uniform writeonly image2D dst;
layout(push_constant) uniform P { uvec4 con0, con1, con2, con3; uvec2 size; uint flip, srgb; } pc;
#define A_GPU 1
#define A_GLSL 1
#include "ffx_a.h"
#define FSR_EASU_F 1
AF4 FsrEasuRF(AF2 p) { return textureGather(src, p, 0); }
AF4 FsrEasuGF(AF2 p) { return textureGather(src, p, 1); }
AF4 FsrEasuBF(AF2 p) { return textureGather(src, p, 2); }
#include "ffx_fsr1.h"
vec3 to_srgb(vec3 c) { return mix(c * 12.92, 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055, step(vec3(0.0031308), c)); }
void main() {
    uvec2 ip = gl_GlobalInvocationID.xy;
    if (ip.x >= pc.size.x || ip.y >= pc.size.y) return;
    uvec2 q = pc.flip != 0u ? uvec2(ip.x, pc.size.y - 1u - ip.y) : ip;
    AF3 c;
    FsrEasuF(c, q, pc.con0, pc.con1, pc.con2, pc.con3);
    if (pc.srgb != 0u) c = to_srgb(clamp(c, 0.0, 1.0));   // a sRGB frame is sampled as linear: back to what the screen shows
    imageStore(dst, ivec2(ip), vec4(c, 1.0));
}
