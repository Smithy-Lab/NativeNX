# The graphics backend. With Vulkan (the loader and headers: on Fedora vulkan-loader-devel), NVN runs on gfx/ (the Vulkan
# replay) with yuzu's shader recompiler (third_party/shader_recompiler) translating the game's shaders at run time; it
# needs fmt, Boost's header-only libraries, sirit and SPIR-V's headers, taken from the system when they are there and
# fetched otherwise. SDL3 (SDL3-devel) gives it a window; without SDL3 frames can only be written to files. Without
# Vulkan, or with -DNXL_VULKAN=OFF, the null backend runs the game with nothing drawn.
option(NXL_VULKAN "Build the Vulkan graphics backend" ON)
set(NXL_GFX_LIBS)
set(NXL_GFX_DEFS)
if(NXL_VULKAN)
    find_package(Vulkan QUIET)
    if(NOT Vulkan_FOUND)
        message(WARNING "Vulkan not found (install vulkan-loader-devel): building the null graphics backend, nothing will be drawn")
        set(NXL_VULKAN OFF)
    endif()
endif()
if(NOT NXL_VULKAN)
    set(NXL_GFX_BACKEND_SOURCES compat/nxnative/nvn_null.c)
    set(NXL_GFX_BACKEND_C compat/nxnative/nvn_null.c)
    return()
endif()

include(FetchContent)
# fmt
find_package(fmt QUIET)
if(NOT fmt_FOUND)
    message(STATUS "fmt: fetching it")
    FetchContent_Declare(fmt GIT_REPOSITORY https://github.com/fmtlib/fmt.git GIT_TAG 11.1.4 GIT_SHALLOW TRUE EXCLUDE_FROM_ALL)
    set(FMT_INSTALL OFF CACHE BOOL "" FORCE)
    FetchContent_MakeAvailable(fmt)
endif()
# Boost's headers (container, intrusive and what they use)
find_package(Boost 1.79 QUIET)
if(Boost_FOUND)
    if(NOT TARGET Boost::headers)
        add_library(Boost::headers INTERFACE IMPORTED)
        set_target_properties(Boost::headers PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${Boost_INCLUDE_DIRS}")
    endif()
else()
    message(STATUS "Boost: fetching the header libraries the shader recompiler uses")
    set(NXL_BOOST_INCS)
    foreach(m container intrusive move config assert static_assert core predef throw_exception type_traits container_hash describe mp11 detail utility)
        FetchContent_Declare(boost_${m} GIT_REPOSITORY https://github.com/boostorg/${m}.git GIT_TAG boost-1.87.0 GIT_SHALLOW TRUE)
        FetchContent_GetProperties(boost_${m})
        if(NOT boost_${m}_POPULATED)
            FetchContent_Populate(boost_${m})
        endif()
        list(APPEND NXL_BOOST_INCS ${boost_${m}_SOURCE_DIR}/include)
    endforeach()
    add_library(nxl_boost_headers INTERFACE)
    target_include_directories(nxl_boost_headers SYSTEM INTERFACE ${NXL_BOOST_INCS})
    add_library(Boost::headers ALIAS nxl_boost_headers)
endif()
# sirit (SPIR-V emitter) with SPIR-V's headers
if(NOT TARGET sirit)
    find_package(SPIRV-Headers CONFIG QUIET)   # spirv-headers-devel; else sirit's own submodule
    set(SIRIT_USE_SYSTEM_SPIRV_HEADERS ${SPIRV-Headers_FOUND} CACHE BOOL "" FORCE)
    set(NXL_SIRIT_SOURCE "" CACHE PATH "a local sirit checkout (with externals/SPIRV-Headers), instead of fetching it")
    if(NXL_SIRIT_SOURCE)
        add_subdirectory(${NXL_SIRIT_SOURCE} ${CMAKE_CURRENT_BINARY_DIR}/sirit EXCLUDE_FROM_ALL)
    else()
        message(STATUS "sirit: fetching it")
        FetchContent_Declare(sirit GIT_REPOSITORY https://github.com/ReinUsesLisp/sirit.git GIT_TAG 7b9a59b7c803df9f861b6d5619a75ef3e46bbed5
                             GIT_SUBMODULES_RECURSE TRUE EXCLUDE_FROM_ALL)
        FetchContent_MakeAvailable(sirit)
    endif()
    set_target_properties(sirit PROPERTIES POSITION_INDEPENDENT_CODE ON)
endif()
add_subdirectory(third_party/shader_recompiler EXCLUDE_FROM_ALL)
add_library(nxl_astc STATIC third_party/astc/astc.cpp)
target_link_libraries(nxl_astc PRIVATE shader_recompiler)
target_compile_options(nxl_astc PRIVATE -w)
set_target_properties(nxl_astc PROPERTIES POSITION_INDEPENDENT_CODE ON)

set(NXL_GFX_BACKEND_C gfx/vk_core.c gfx/vk_tex.c gfx/vk_draw.c gfx/vk_present.c gfx/vk_upscale.c gfx/vk_overlay.c gfx/vk_stubs.c)
set(NXL_GFX_BACKEND_SOURCES ${NXL_GFX_BACKEND_C} gfx/nxl_shader.cpp)
set(NXL_GFX_LIBS Vulkan::Vulkan shader_recompiler nxl_astc)
find_package(SDL3 CONFIG QUIET)
if(SDL3_FOUND)
    list(APPEND NXL_GFX_LIBS SDL3::SDL3)
    list(APPEND NXL_GFX_DEFS NXL_HAVE_SDL3=1)
    list(APPEND NXL_GFX_BACKEND_C gfx/nxl_input.c)
    list(APPEND NXL_GFX_BACKEND_SOURCES gfx/nxl_input.c)
    message(STATUS "graphics: Vulkan, window with SDL3 ${SDL3_VERSION}")
else()
    message(WARNING "SDL3 not found (install SDL3-devel): no window; NXL_DUMP_FRAMES=<folder> writes frames to files")
endif()
set_source_files_properties(gfx/nxl_shader.cpp PROPERTIES COMPILE_OPTIONS "-std=c++23;-w")
